{
  "name": "school-class-hub",
  "version": "1.0.0",
  "description": "کلاس‌هاب — درگاه سرِ کلاس: برنامه هفتگی، تکالیف، مهلت‌ها و اطلاعیه‌ها روی Cloudflare Workers",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "node scripts/build_singlefile.mjs",
    "deploy": "node scripts/build_singlefile.mjs && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/*.test.mjs'",
    "db:migrate:local": "wrangler d1 migrations apply school_class_db --local",
    "db:migrate": "wrangler d1 migrations apply school_class_db --remote",
    "db:seed:local": "wrangler d1 execute school_class_db --local --file=./seed.sql",
    "db:seed": "wrangler d1 execute school_class_db --remote --file=./seed.sql",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "docx": "^9.16.1",
    "hono": "^4.13.19"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.164.0"
  }
}
