{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "school",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-18",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "school_class_db",
      "database_id": "088760d4-d060-4920-81b1-7b8d33be81c7"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_NAME": "کلاس‌هاب",
    "SESSION_TTL_HOURS": "12"
  }
}
