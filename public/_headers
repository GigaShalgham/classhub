# صفحات HTML همیشه از سرور اعتبارسنجی شوند (etag → 304) تا هر دیپلوی
# بلافاصله برای همه‌ی کاربران دیده شود. پیش‌فرض پلتفرم (max-age=300 +
# stale-while-revalidate=86400) باعث می‌شد مرورگر تا یک روز نسخه‌ی کهنه نشان دهد.
/
  Cache-Control: public, max-age=0, must-revalidate
/admin
  Cache-Control: public, max-age=0, must-revalidate
/admin/*
  Cache-Control: public, max-age=0, must-revalidate
